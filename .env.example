# Model Configuration
MODEL_NAME=uni2-h
EMBEDDING_DIM=1536
HIDDEN_DIM=512
NUM_CLASSES=2

# Data Paths
DATA_DIR=/path/to/wsi/data
TILE_DIR=/path/to/tiles
EMBEDDING_DIR=/path/to/embeddings
OUTPUT_DIR=./outputs

# Training Configuration
BATCH_SIZE=1
NUM_EPOCHS=100
LEARNING_RATE=0.0001
WEIGHT_DECAY=0.00001

# Hardware
DEVICE=cuda
GPU_IDS=0
NUM_WORKERS=4

# Experiment Tracking
MLFLOW_TRACKING_URI=./mlruns
EXPERIMENT_NAME=thyroid_braf_prediction

# Logging
LOG_LEVEL=INFO
SAVE_CHECKPOINTS=True
CHECKPOINT_DIR=./checkpoints
